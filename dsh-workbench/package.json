{
  "name": "dsh-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A minimal DeepSeek Harness plugin for governed AI workbenches.",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./persistence": "./dist/persistence/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    ".env.example",
    "mcp",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && pnpm copy:assets",
    "build:dashboard": "tsc -p tsconfig.dashboard.json && pnpm copy:assets",
    "copy:assets": "node scripts/copy-static-assets.mjs",
    "dashboard:run": "node dist-dashboard/dashboard-build/cli.js",
    "dataset:analyze": "node dist-dashboard/data-ingestion/cli.js",
    "library:run": "node dist-dashboard/library/cli.js",
    "db:migrate": "node dist/persistence/cli.js",
    "templates:build": "node dist-dashboard/design-library/template-cover-cli.js",
    "local:app": "node dist-dashboard/local-app/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dshRuntime": {
    "requires": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/dsh-tools",
      "@deepseek-ai/dsh-llm",
      "@deepseek-ai/dsh-host-webserver",
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-mcp-client"
    ],
    "note": "Resolved by the DeepSeek Harness source workspace; not fetched from the public npm registry."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.23.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@arizeai/openinference-core": "2.6.1",
    "@arizeai/phoenix-otel": "2.2.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1"
  }
}
