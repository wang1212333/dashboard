# The plugin never exposes these values to generated HTML.
WORKBENCH_API_BASE_URL=http://127.0.0.1:8787
WORKBENCH_SERVICE_TOKEN=replace-me

# P2 remote library adapter. The endpoints belong in the DSH profile; only
# variable names are referenced from configuration, and only tokens live here.
WORKBENCH_OBJECT_STORAGE_TOKEN=replace-me
WORKBENCH_METADATA_SERVICE_TOKEN=replace-me

# Authoritative metadata database. This is server-only: never expose it in
# browser code, dashboard HTML or an Agent prompt.
DATABASE_URL=postgresql://dsh_workbench:replace-me@127.0.0.1:5432/dsh_workbench

# DSH host environment only. Never expose these values to generated HTML,
# plugin source, dashboard exports, session text, or tool parameters.
WORKBENCH_METADATA_MCP_URL=https://metadata-mcp.example.com/mcp
WORKBENCH_METADATA_MCP_TOKEN=replace-me
WORKBENCH_DATA_MCP_URL=https://data-mcp.example.com/mcp
WORKBENCH_DATA_MCP_TOKEN=replace-me

# OpenMetadata semantic evidence MCP. Use a token whose OMD role is limited to
# data asset read access; do not use a governance or administrator token.
OPENMETADATA_MCP_URL=https://openmetadata.transsion.com/mcp
OPENMETADATA_MCP_TOKEN=replace-me

# Phoenix / OpenInference tracing. Enable only in a trusted development or
# observability environment. Credentials remain in the DSH host process.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT=dsh-workbench
PHOENIX_API_KEY=replace-me
# Local debugging only: sends model prompt/output to Phoenix. Keep false in
# shared or production environments unless an approved data policy permits it.
DSH_TRACE_CAPTURE_CONTENT=false
DSH_TRACE_MAX_CAPTURE_CHARS=24000
